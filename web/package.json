{
  "name": "media-maid-ui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Read-only web UI of Media Maid, embedded in the binary (internal/ui).",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "gen:api": "openapi-typescript ../internal/api/openapi.yaml -o src/api/schema.d.ts",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "build": "node scripts/clean.mjs && vite build"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.57.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.2",
    "openapi-typescript": "^7.13.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
